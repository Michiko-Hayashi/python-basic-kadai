      "source": [
        "array = [\"水\",\"金\",\"地\",\"火\",\"木\",\"土\",\"天\",\"海\",\"冥\"]\n",
        "# forを使用して水～冥まで順番に表示する\n",
        "for planet in array:\n",
        "  print(planet)\n",
        "\n",
        "# whileを使用して水～冥まで順番に表示する\n",
        "# インデックスを初期化\n",
        "i = 0\n",
        "while i < len(array):\n",
        "  print(array[i])\n",
        "  #インデックス更新\n",
        "  i +=1"
      ]
    }

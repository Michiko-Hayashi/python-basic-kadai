      "source": [
        "# 商品購入時の消費税を定義する\n",
        "def total(price, tax) :\n",
        "  # 税込み価格を計算\n",
        "  result = price + (price * tax / 100)\n",
        "  return result\n",
        "\n",
        "# 実行例\n",
        "print(total(110, 10))"
      ]
    }
